APP_NAME="ERP Neni"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://neni.gustavoquintero.dev
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=erp_neni
DB_USERNAME=app_erp_neni
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Cuenta pública de demostración (solo lectura).
DEMO_CORREO=demo@erpneni.test
DEMO_CLAVE=demo-erp-neni
